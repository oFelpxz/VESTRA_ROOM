# === VESTRA ROOM — modelo de variáveis de ambiente ===
# Copie para .env e preencha. O .env real não vai para o Git.

# --- Banco (Supabase / PostgreSQL) ---
# App em runtime: pooler transaction-mode, porta 6543, com ?pgbouncer=true
DATABASE_URL="postgresql://postgres.SEU_REF:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations / seed: conexão de sessão, porta 5432
DIRECT_URL="postgresql://postgres.SEU_REF:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# --- Auth.js (NextAuth v5) ---
# Gere com: npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# --- Supabase Storage (modelos 3D — item 26) ---
# Sem estas três, o upload de .glb cai no filesystem local (public/models/).
SUPABASE_URL="https://SEU_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"
SUPABASE_MODELS_BUCKET="models-3d"

# --- Opcional ---
# Base usada pelo webhook de pagamento simulado. Default: http://localhost:3000
# NEXT_PUBLIC_BASE_URL="https://seu-dominio.com"

# --- Pagamento: Stripe em modo de teste (Sprint 4, itens 16, 17 e 20) ---
# Sem STRIPE_SECRET_KEY, o checkout continua no pagamento simulado.
# Passo a passo: docs/SPRINT4-CHAVES.md
STRIPE_SECRET_KEY="sk_test_xxx"
# Do `stripe listen` (local) ou do endpoint cadastrado no painel (Vercel).
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Frete: Melhor Envio sandbox (Sprint 4, item 18) ---
# Sem token, o frete continua com a tabela interna (Econômico/Expresso).
MELHOR_ENVIO_TOKEN="token_do_sandbox"
# CEP de onde a loja despacha. Default: 01310100 (Av. Paulista, SP).
# MELHOR_ENVIO_FROM_CEP="01310100"
# Troque para https://melhorenvio.com.br em produção.
# MELHOR_ENVIO_BASE_URL="https://sandbox.melhorenvio.com.br"
